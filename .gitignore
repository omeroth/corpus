# Python helper scripts (not part of the app)
*.py
__pycache__/
*.pyc

# macOS metadata files
.DS_Store
**/.DS_Store

# Editor / IDE
.vscode/
.idea/

# Logs
*.log

# Capacitor / Node
node_modules/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/

# Android signing keystores — NEVER commit. Losing them means you can never update the app on Play Store.
*.jks
*.keystore
keystore.properties
android/keystore/

# Image-optimization backup (created before mass WebP conversion). Not part of the app.
images.original-backup/

# Supabase CLI local scratch (linked-project state, poller state, version pins).
# Rewritten on every `supabase` invocation; noisy in git status and not portable.
supabase/.temp/

# Source design PNGs (icon + splash originals). Kept on disk for local editing;
# not shipped to any deploy and not needed for iOS/Android builds.
design/

# iOS build caches (Xcode-generated, huge, always regeneratable).
ios/DerivedData/
ios/build/

# Capacitor auto-generates ios/App/App/public/ on every `cap sync ios` by copying
# www/. Keeping it out of git means the working tree stays clean between syncs.
ios/App/App/public/

# www/ is a sync-generated mirror produced by `npm run sync-web` from the
# tracked sources at the repo root (images/, content/, assets/, media/).
# Only www/index.html is tracked as the Capacitor entrypoint; the rest is
# derivable and would otherwise double every image diff.
# Fresh clone must run `npm run sync-web` before `npx cap sync ios`.
www/images/
www/content/
www/assets/
www/media/

# Android build caches (Gradle-generated).
android/app/build/
android/build/
android/.gradle/

# Capacitor scratch.
.capacitor/

# GitHub Actions Pages deploy assembly directory (only exists on the runner,
# but if you ever invoke the workflow locally it lands here).
_deploy/

# Share-card generator: font TTFs are downloaded locally, not committed
# (see scripts/fonts/README.md). Generated cards + pages are committed so
# GitHub Pages can serve them without a CI generation step.
scripts/fonts/*.ttf

# Gemini-generated PNGs get dropped into images/ during design exploration
# but aren't referenced by the app. Ignore at any depth so drops into
# images/ or www/images/ don't clutter git status.
**/Gemini_Generated_Image_*.png

# Thinker-frames handoff — spec + reference designs for the multi-
# commit thinker-card progression work. Kept on disk for reference
# but excluded from git so the folder can't end up served by GH
# Pages under corpusapp.io. Rendered assets the app actually depends
# on will land in images/ (or an equivalent tracked path), not here.
thinker-frames-handoff/

# Design reference files (prototype HTML + raw thinker PNGs
# unzipped from small-thinkers.zip). Local-only — the committed
# thinker assets live in images/onb-thinkers/ once converted.
design-ref/

# Capacitor regenerates android/app/src/main/assets/public/ on every
# `npx cap sync android` by copying www/ (same deal as ios/App/App/public/).
# Fresh clone must run `npm run sync-web && npx cap sync android` before
# any Android build.
android/app/src/main/assets/

# Xcode / SwiftPM user-local scratch (per-user schemes, build state).
ios/App/CapApp-SPM/.swiftpm/
ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/configuration/

# Gradle / Kotlin build caches.
android/.kotlin/

# Widget-preview CLI build output (Swift binary compiled from
# scripts/widget-preview/preview_main.swift via xcrun swiftc).
scripts/widget-preview/preview_cli

# Claude CLI session scratch (per-user settings + schedule lock file).
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Content-authoring handoff drops (raw .txt sources the authors send
# before transcription into content/*.js). Not consumed at runtime.
*-chapter*-en.txt
*-chapter*-he.txt

# SwiftPM scratch inside Capacitor plugins (build output + per-user scheme state).
plugins/*/.build/
plugins/*/.swiftpm/
