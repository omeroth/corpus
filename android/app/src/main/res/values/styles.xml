<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- windowBackground was @android:color/white — that produced a white
             flash between the OS splash disappearing and the webview's first
             paint. Swapping to brand purple removes the flash: even before
             the HTML splash div paints, the underlying window is already
             #7B4FD4. Same value referenced by AppTheme.NoActionBarLaunch. -->
        <item name="android:windowBackground">@color/splash_purple</item>
        <item name="android:colorBackground">@color/splash_purple</item>
        <!-- OS system navigation bar. Fixed black so it stays neutral across
             every subject and both light/dark modes. Without this attribute,
             Android defaults the nav-bar background to colorBackground above
             (splash_purple = philosophy #7B4FD4), which leaked the brand
             color into a surface no theme owns. windowLightNavigationBar
             = false requests light (white) icons — 21:1 contrast on black,
             renders correctly on every OEM skin. Requires API 26+; minSdk
             already exceeds that. Theme is the single source of truth for
             this surface — do not also set it from JS or plugin config. -->
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Android 12+ native splash-screen API uses windowSplashScreenBackground
             instead of the drawable-based background. Setting it to the same
             purple keeps the native splash surface flush with the wordmark PNG
             and the post-splash windowBackground above. -->
        <item name="android:windowSplashScreenBackground">@color/splash_purple</item>
    </style>
</resources>