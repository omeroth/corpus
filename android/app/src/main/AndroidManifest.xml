<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Meta App Events SDK — required meta-data. App ID + Client Token
             wire the SDK to our Meta developer console entry. The advertising
             ID collection flag is set imperatively in
             CorpusMetaEventsPlugin.load(), but Meta also reads the plist/
             manifest boolean at very-early init paths — declaring "false"
             here defends against any race where an internal Meta hook fires
             before the plugin's load() runs.
             PRIVACY DECLARATION COMMITMENT: com.facebook.sdk.AdvertiserIDCollectionEnabled
             must stay false. See the DO-NOT-CHANGE comment at the top of
             plugins/corpus-meta-events/android/.../CorpusMetaEventsPlugin.java. -->
        <meta-data android:name="com.facebook.sdk.ApplicationId"
                   android:value="@string/facebook_app_id" />
        <meta-data android:name="com.facebook.sdk.ClientToken"
                   android:value="@string/facebook_client_token" />
        <meta-data android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
                   android:value="false" />
        <meta-data android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
                   android:value="true" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Explicit removals. The Facebook SDK ships as a transitive dep of
         @capgo/capacitor-social-login (facebook-core:18.1.3) and injects
         Google Play Services advertising-attribution permissions into the
         merged manifest. Corpus uses no ads and no advertising ID, so we
         strip them here to keep the Play Data Safety declaration honest and
         let us answer "No" to the AD_ID prompt. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_CUSTOM_AUDIENCE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />
</manifest>
